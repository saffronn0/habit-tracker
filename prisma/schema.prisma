generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  habits        Habit[]
  pointsEntries PointsEntry[]
  profile       Profile?

  @@map("users")
}

model Habit {
  id             String   @id @default(cuid())
  // Nullable so pre-auth data can keep existing until claimed by the first
  // account created after this migration (see claimLegacyData in actions.ts).
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  emoji          String   @default("✨")
  color          String   @default("violet")
  pointStake     Int      @default(10)
  consequenceText String?
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Date (YYYY-MM-DD) of the last missed day we already deducted points for,
  // so a broken streak is only penalized once instead of on every page load.
  lastPenaltyDate String?

  logs         HabitLog[]
  pointsEntries PointsEntry[]

  @@index([userId])
  @@map("habits")
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  // Stored as YYYY-MM-DD (local date, not a timestamp) so a day is unambiguous
  // regardless of time-of-day the check-in happens.
  date      String
  completed Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([habitId, date])
  @@map("habit_logs")
}

model PointsEntry {
  id      String  @id @default(cuid())
  // Nullable for the same reason as Habit.userId — see claimLegacyData.
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // YYYY-MM-DD, same convention as HabitLog.date
  date    String
  delta   Int
  reason  String
  habitId String?
  habit   Habit?  @relation(fields: [habitId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([date])
  @@index([userId])
  @@map("points_entries")
}

model Profile {
  id          String  @id @default(cuid())
  userId      String? @unique
  user        User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalPoints Int     @default(0)

  @@map("profile")
}
